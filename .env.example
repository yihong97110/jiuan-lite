# jiuan-lite 环境变量模板：复制为 .env 并填入真实 Key
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# 也可启动后在前端「⑬ 设置 · API Key」页配置（写入同一文件，长期持久化）

# ---- DeepSeek 官方 API（对话默认后端 + LLM-as-Judge 裁判）----
# 申请: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ---- Tavily 联网搜索（可选，免费 1000 次/月；不配则自动用 360/Bing 兜底）----
# 申请: https://tavily.com
TAVILY_API_KEY=

# ---- OpenAI / 火山方舟（可选，蒸馏生成与自定义裁判端点用）----
OPENAI_API_KEY=
ARK_API_KEY=
